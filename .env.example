# Copy to .env for local use. On Vercel, add these under Project → Settings → Environment Variables.
# Never commit real values.

# --- Access -------------------------------------------------------------------------------
APP_PASSWORD=                 # password for the workspace (required on a deployment unless OPEN_ACCESS/DEMO_MODE)
APP_SECRET=                   # random string used to sign session cookies (openssl rand -hex 24)
# OPEN_ACCESS=1               # anyone with the link can use it (sending still only reaches OWN_EMAIL)
# DEMO_MODE=1                 # fictional sample workspace; auto-on for a deployment with no DATABASE_URL
APP_NAME=Prospect Studio
# REPO_URL=https://github.com/ayushsharma-maker/prospect-studio
# REPORT_URL=

# --- AI model (one of these) ----------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini         # gemini | anthropic (default: config/icp.yaml, falls over to whichever key exists)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

# --- Research and contacts ------------------------------------------------------------------
HUNTER_API_KEY=

# --- Storage ---------------------------------------------------------------------------------
DATABASE_URL=                 # Postgres (Supabase pooler URL). Without it: SQLite (local file, or /tmp on Vercel)

# --- Email, calendar, CRM -------------------------------------------------------------------
OWN_EMAIL=                    # the ONLY address the system can ever send to
GOOGLE_TOKEN_JSON=            # from: python -m src.google_setup (paste the JSON on one line)
GMAIL_CLIENT_SECRET_FILE=client_secret.json
HUBSPOT_TOKEN=                # optional: HubSpot private-app token for update_crm
AGENT_TIMEZONE=Asia/Kolkata
# AGENT_NO_REPLY_HOURS=48

# --- Scheduler -------------------------------------------------------------------------------
CRON_SECRET=                  # shared with the GitHub Actions secret of the same name
